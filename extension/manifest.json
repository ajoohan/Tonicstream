{
  "manifest_version": 3,
  "name": "Tonicstream 영상 저장",
  "version": "0.1.0",
  "description": "브라우저에서 재생 중인 영상(쇼츠·릴스·틱톡 등)을 MP4로 저장합니다.",
  "permissions": ["webRequest", "downloads", "storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "영상 저장" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
